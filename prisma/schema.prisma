// FriendConnect — CANONICAL Prisma schema
// Matches the field names used by socket-server.js, all 100 API routes,
// and all FC components. This is the single source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  name               String
  passwordHash       String
  avatarUrl          String?
  bio                String?
  status             String   @default("")
  role               String   @default("user") // user | admin
  // Boolean, not DateTime: every caller treats this as a flag
  // (`where: { emailVerified: true }`, `emailVerified ?? false`).
  emailVerified      Boolean  @default(false)
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // 2FA
  twoFactorEnabled   Boolean  @default(false)
  // Unconfirmed secret from /api/2fa/setup. Only /api/2fa/verify reads it, and
  // only until the first valid code confirms it (finding #6).
  twoFactorSecret    String?
  // Confirmed TOTP secret. Set at the same moment 2FA becomes enabled.
  twoFactorConfirmedSecret String?
  // Newline-separated SHA-256 digests of the backup codes; each is removed on
  // use so it can never be redeemed twice.
  twoFactorBackup    String?
  twoFactorBackupUsed Int     @default(0)
  // Failed-code counter for the login challenge, cleared on success.
  twoFactorAttempts  Int      @default(0)

  // One-time codes (password reset / e-mail verification).
  // `otpCode` holds a scrypt hash, never the code itself (finding #5).
  otpCode            String?
  otpExpiry          DateTime?
  // Brute-force counter; the code is destroyed once MAX_ATTEMPTS is reached.
  otpAttempts        Int       @default(0)
  // Earliest time a new code may be issued, to throttle re-sends.
  otpSentAt          DateTime?
  // SHA-256 digest of the opaque, single-use credential issued by verify-otp.
  resetTokenHash     String?
  resetTokenExpiry   DateTime?

  // File quota
  fileUsedBytes      Int      @default(0)
  fileQuotaBytes     Int      @default(104857600) // 100 MB

  // E2EE
  publicKey          String?

  // Relations
  sessions           Session[]
  profile            Profile?
  ownedGroups        Group[]                @relation("GroupOwner")
  groupMemberships   GroupMember[]
  sentMessages       Message[]              @relation("MessageSender")
  receivedMessages   Message[]              @relation("MessageReceiver")
  callsMade          Call[]                 @relation("CallCaller")
  callsReceived      Call[]                 @relation("CallReceiver")
  files              File[]
  notifications      Notification[]         @relation("NotificationOwner")
  messageStars       MessageStar[]
  messageDrafts      MessageDraft[]
  messageReminders   MessageReminder[]
  friendRequestsSent   FriendRequest[]      @relation("FriendRequestFrom")
  friendRequestsRecv   FriendRequest[]      @relation("FriendRequestTo")
  friendshipRequests  Friendship[]          @relation("FriendshipRequester")
  friendshipReceived  Friendship[]          @relation("FriendshipReceiver")
  conversationMemberships ConversationMember[]
  blocksIssued  Block[]              @relation("BlockFrom")
  blocksRecv    Block[]              @relation("BlockTo")
  reportsIssued Report[]             @relation("ReportFrom")
  reportsRecv   Report[]             @relation("ReportTo")
  chatPreferences    ChatPreference[]
  auditLogs          AuditLog[]
  pushSubscriptions  PushSubscription[]
  fileAccessGrants   FileAccess[]         @relation("FileAccessUser")
  messageReactions   MessageReaction[]    @relation("MessageReactionUser")
  stories            Story[]
  storyViews         StoryView[]
  storyReplies       StoryReply[]
  storyReactions     StoryReaction[]
  broadcastLists     BroadcastList[]        @relation("BroadcastOwner")
  broadcastMemberships BroadcastMember[]
  posts              Post[]
  postComments       PostComment[]
  postReactions      PostReaction[]
  pollVotes          PollVote[]
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  sessionToken  String   @unique
  token         String?
  expiresAt     DateTime
  userAgent     String?
  ipAddress     String?
  deviceName    String?
  createdAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  photoUrl            String?
  bio                 String?
  phone               String?
  location            String?
  birthday            DateTime?
  education           String?
  work                String?
  lastSeen            DateTime @default(now())
  profileVisibility   String   @default("PUBLIC")
  messagePermission   String   @default("FRIENDS")
  callPermission      String   @default("FRIENDS")
  readReceipts        Boolean  @default(true)
  photoFilter         String?
  verified            String   @default("unverified")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// FRIENDSHIP (requesterId / receiverId — matches socket-server.js)
// ============================================================

model Friendship {
  id              String   @id @default(cuid())
  requesterId     String
  receiverId      String
  status          String   @default("PENDING") // PENDING | ACCEPTED | BLOCKED
  blockerId       String?
  isCloseFriend   Boolean  @default(false)
  storiesMuted    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

// ============================================================
// MESSAGING (receiverId / groupId / type / fileUrl / status / deletedFor / edited / etc.)
// ============================================================

model Message {
  id              String    @id @default(cuid())
  senderId        String
  receiverId      String?
  groupId         String?
  conversationId  String?
  content         String
  type            String    @default("text") // text | image | video | audio | file | location | poll | admin | custom | system
  fileUrl         String?
  fileName        String?
  fileSize        Int?
  mimeType        String?
  replyToId       String?
  forwardedFrom   String?
  status          String    @default("SENT") // SENT | DELIVERED | SEEN
  deletedFor      String?   // null | "everyone" | comma-separated user IDs
  edited          Boolean   @default(false)
  editedAt        DateTime?
  pinnedBy        String?
  seenAt          DateTime?
  scheduledFor    DateTime?
  expiresAt       DateTime?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sender    User       @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User?      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  replyTo   Message?   @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]  @relation("MessageReply")
  group        Group?             @relation("MessageGroup", fields: [groupId], references: [id], onDelete: SetNull)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  stars        MessageStar[]
  reminders    MessageReminder[]
  reactions    MessageReaction[]
  attachments  Attachment[]
  fileAccess   FileAccess[]

  @@index([receiverId, status])
  @@index([senderId])
  @@index([groupId])
  @@index([conversationId])
}

model MessageStar {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Required by every read path: `reactions: { include: { user: ... } }`.
  user    User    @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageDraft {
  id        String   @id @default(cuid())
  userId    String
  peerId    String
  isGroup   Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, peerId, isGroup])
}

model MessageReminder {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  remindAt  DateTime
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, notified])
}

model ChatPreference {
  id           String   @id @default(cuid())
  userId       String
  peerId       String
  pinned       Boolean  @default(false)
  muted        Boolean  @default(false)
  archived     Boolean  @default(false)
  disappearing String?  // off | 24h | 7d | 30d
  wallpaper    String?
  folder       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, peerId])
}

// ============================================================
// GROUPS
// ============================================================

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  photoUrl    String?
  createdBy   String
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User?          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  GroupMember[]
  messages Message[]      @relation("MessageGroup")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// ============================================================
// CALLS (receiverId — matches socket-server.js)
// ============================================================

model Call {
  id              String    @id @default(cuid())
  callerId        String
  receiverId      String
  type            String    // audio | video
  status          String    @default("ringing") // ringing | accepted | rejected | missed | completed | failed
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?      // seconds
  failureReason   String?
  connectionType  String?   // p2p | relay | srflx
  createdAt       DateTime  @default(now())

  caller   User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
}

// ============================================================
// FILES (name — matches API routes)
// ============================================================

model File {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  // Optional: upload routes write `name` + `url` only. A required `filename`
  // made every POST /api/files/upload fail against a Prisma backend.
  filename   String?
  mimeType   String
  size       Int
  url        String   @unique
  thumbUrl   String?
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Download authorization resolves through this relation instead of scanning
  // the Message table for a matching fileUrl.
  @@index([ownerId])
}

// ============================================================
// NOTIFICATIONS (userId — matches API routes)
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ============================================================
// STORIES
// ============================================================

model Story {
  id          String   @id @default(cuid())
  userId      String
  mediaUrl    String?
  mediaType   String   @default("image") // image | video
  type        String   @default("text") // text | image | video
  content     String?
  bg          String?
  caption     String?
  isHighlight Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  views      StoryView[]
  replies    StoryReply[]
  reactions  StoryReaction[]

  @@index([userId])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryReply {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId, emoji])
}

// ============================================================
// BROADCASTS
// ============================================================

model BroadcastList {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  owner   User             @relation("BroadcastOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members BroadcastMember[]
}

model BroadcastMember {
  id             String   @id @default(cuid())
  broadcastListId String
  recipientId    String
  createdAt      DateTime @default(now())

  broadcastList BroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  recipient    User           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

// ============================================================
// PUSH SUBSCRIPTIONS
// ============================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String?
  auth      String?
  keys      String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  resource   String?
  ip         String?
  userAgent  String?
  detail     String?
  meta       String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================================
// POSTS (activity feed)
// ============================================================

model Post {
  id          String   @id @default(cuid())
  authorId    String
  content     String
  mediaUrl    String?
  visibility  String   @default("friends")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     PostComment[]
  reactions    PostReaction[]
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

// ============================================================
// POLLS
// ============================================================

model Poll {
  id          String    @id @default(cuid())
  messageId   String
  question    String
  options     String    // JSON array
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  votes PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// ============================================================
// CONVERSATIONS (legacy — kept for backward compat)
// ============================================================

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("direct")
  title       String?
  avatarUrl   String?
  description String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  role            String   @default("member")
  joinedAt        DateTime @default(now())
  lastReadAt      DateTime?
  muted           Boolean  @default(false)
  pinned          Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Block {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from User @relation("BlockFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("BlockTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Report {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  reason    String
  detail    String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  from User @relation("ReportFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReportTo", fields: [toId], references: [id], onDelete: Cascade)
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String?
  ownerId    String
  filename   String
  mimeType   String
  size       Int
  url        String
  thumbUrl   String?
  createdAt  DateTime @default(now())

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([url])
  @@index([ownerId])
}

// ============================================================
// FILE ACCESS GRANTS
// ============================================================
//
// Download authorization for a stored file used to be decided by scanning the
// whole Message table for a matching `fileUrl` (unindexed, capped at 100 rows,
// and silently wrong once a URL had more than 100 references). Each row here is
// one explicit, indexed grant: "`userId` may read `fileUrl`".
//
// Grants are written when a file is attached to a message and are revoked when
// the message is deleted for everyone or the story expires. Legacy files that
// predate this table are covered by a one-off backfill in
// `prisma/migrations/..._add_fileaccess_and_attachments` and by the ownership
// and profile-visibility rules that remain in `src/lib/file-access.ts`.

model FileAccess {
  id        String   @id @default(cuid())
  fileUrl   String
  userId    String
  // owner | message_recipient | group_member | story_viewer | profile_public
  source    String
  // Populated when the grant comes from a message so it can be revoked.
  messageId String?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user    User     @relation("FileAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([fileUrl, userId])
  @@index([fileUrl])
  @@index([userId])
  @@index([messageId])
}


model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from User @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// ============================================================
// JARA — Permanent AI User + Governance
// ============================================================

model JaraConfig {
  id                String   @id @default(cuid())
  version           Int      @unique @default(1)
  // Identity
  displayName       String   @default("Jara AI")
  aiDisclosure      String   @default("I am Jara AI, a digital human assistant. I am not a real human.")
  isEnabled         Boolean  @default(true) // emergency disable / kill switch
  // Visual identity
  face              String   @default("realistic") // realistic | illustrated | anime | friendly | professional
  avatar            String   @default("default")  // 2d | 3d | default
  avatarUrl         String?
  background        String   @default("gradient-emerald")
  backgroundUrl     String?
  theme             String   @default("light") // light | dark | futuristic
  colors            String?  // JSON string
  animation         String?  // JSON string
  clothing          String?  // JSON string
  defaultAppearanceProfileId String?
  // Voice
  voiceModel        String   @default("default")
  voiceLanguage     String   @default("bn")
  voiceAccent       String?
  speakingSpeed     Float    @default(1.0)
  pitch             Float    @default(1.0)
  // Personality
  personality       String   @default("friendly")
  responseLength    String   @default("medium") // short | medium | long
  communicationStyle String  @default("conversational")
  // AI configuration
  llmProvider       String   @default("ollama")
  llmModel          String   @default("llama3.2")
  sttModel          String   @default("whisper")
  ttsModel          String   @default("default")
  memoryEnabled     Boolean  @default(true)
  // Communication permissions
  smsEnabled        Boolean  @default(false)
  callsEnabled      Boolean  @default(true)
  meetingsEnabled   Boolean  @default(false)
  allowGroupListening Boolean @default(false)
  humanHandoffEnabled Boolean @default(true)
  recordingConsentRequired Boolean @default(true)
  approvedKnowledgeMode String @default("open") // open | approved_only
  // Metadata
  isLive            Boolean  @default(false)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model JaraProposal {
  id              String   @id @default(cuid())
  version         Int
  previousVersion Int?
  configJson      String   // JSON of proposed config
  configHash      String   // SHA256 hash for integrity
  status          String   @default("pending") // pending | approved | rejected | expired | applied
  createdBy       String
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  approvedBy      String?
  approvedAt      DateTime?
  appliedAt       DateTime?
  changeSummary   String?
  auditLogs       JaraAuditLog[]

  @@index([status])
  @@index([createdBy])
}

model JaraAuditLog {
  id                String   @id @default(cuid())
  proposalId        String?
  version           Int?
  action            String   // propose | approve | reject | expire | apply | rollback | attempt_blocked | config_change | emergency_disable | emergency_enable
  actorId           String?
  actorRole         String?
  detail            String?
  previousValue     String?  // JSON/string snapshot
  newValue          String?  // JSON/string snapshot
  authorizationResult String? // allowed | denied | pending
  changeReason      String?
  requestId         String?
  sessionId         String?
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())

  proposal JaraProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}

model JaraMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model JaraGroupConsent {
  id            String   @id @default(cuid())
  groupId       String   @unique
  enabled       Boolean  @default(false)
  listenEnabled Boolean  @default(false)
  consentedBy   String?
  consentedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// JARA — Command Center Extensions (additive, backward-compatible)
// ============================================================

model JaraAppearanceProfile {
  id              String   @id @default(cuid())
  name            String
  description     String?
  profileType     String   @default("custom") // office | outdoor | studio | meeting_room | custom
  isDefault       Boolean  @default(false)
  isTemporary     Boolean  @default(false)
  expiresAt       DateTime?
  // Visual
  face            String   @default("realistic")
  avatar          String   @default("default")
  avatarUrl       String?
  background      String   @default("gradient-emerald")
  backgroundUrl   String?
  theme           String   @default("light")
  colors          String?  // JSON
  clothing        String?  // JSON
  animation       String?  // JSON
  // Voice/persona overrides (optional)
  voiceModel      String?
  voiceLanguage   String?  // bn | en | mixed
  speakingSpeed   Float?
  pitch           Float?
  personality     String?
  communicationStyle String?
  // Governance
  createdBy       String?
  updatedBy       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  callAssignments JaraCallPresentation[]

  @@index([isDefault])
  @@index([isActive])
}

model JaraCallPresentation {
  id              String   @id @default(cuid())
  sessionType     String   // audio_call | video_call | meeting | sms | chat
  sessionId       String?  // call/meeting/session id
  roomId          String?
  profileId       String?
  profileSnapshot String?  // JSON snapshot of profile at assignment time
  isTemporary     Boolean  @default(true)
  expiresAt       DateTime?
  status          String   @default("active") // active | expired | cancelled | completed
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile JaraAppearanceProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([sessionType, sessionId])
  @@index([status])
}

model JaraSmsConfig {
  id                    String   @id @default(cuid())
  enabled               Boolean  @default(false)
  provider              String   @default("none") // none | twilio | vonage | local_gateway
  senderId              String?
  webhookSecret         String?
  inboundEnabled        Boolean  @default(false)
  outboundEnabled       Boolean  @default(false)
  requireHumanApproval  Boolean  @default(true)
  allowedCountries      String?  // JSON array
  rateLimitPerHour      Int      @default(20)
  optOutKeywords        String?  // JSON array
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model JaraSmsContact {
  id              String   @id @default(cuid())
  phoneNumber     String
  name            String?
  email           String?
  consentStatus   String   @default("unknown") // unknown | granted | revoked | opted_out
  consentAt       DateTime?
  consentSource   String?
  optedOutAt      DateTime?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages JaraSmsMessage[]

  @@unique([phoneNumber])
  @@index([consentStatus])
}

model JaraSmsMessage {
  id              String   @id @default(cuid())
  contactId       String?
  direction       String   @default("outbound") // inbound | outbound
  fromNumber      String?
  toNumber        String?
  body            String
  language        String?  // bn | en | mixed
  status          String   @default("draft") // draft | pending_approval | approved | queued | sent | delivered | failed | received | blocked
  provider        String?
  providerMessageId String?
  errorMessage    String?
  requiresApproval Boolean @default(true)
  approvedBy      String?
  approvedAt      DateTime?
  consentChecked  Boolean  @default(false)
  metadata        String?  // JSON
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contact JaraSmsContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([direction, status])
  @@index([createdAt])
}

model JaraDonorContribution {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  country         String?
  contributionType String  @default("support") // monetary | non_monetary | volunteer | other
  amount          String?  // store as string; no auto-charge
  currency        String?
  message         String?
  consentToContact Boolean @default(false)
  privacyAccepted Boolean  @default(false)
  status          String   @default("pending_review") // pending_review | verified | acknowledged | rejected
  verifiedBy      String?
  verifiedAt      DateTime?
  acknowledgementSentAt DateTime?
  isPublic        Boolean  @default(false) // never expose by default
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model JaraConsentRecord {
  id              String   @id @default(cuid())
  subjectType     String   // user | contact | meeting_participant | donor
  subjectId       String?
  subjectLabel    String?
  consentType     String   // sms | call_recording | video_recording | data_processing | contact
  status          String   @default("granted") // granted | revoked | pending
  source          String?  // ui | sms | api | admin
  details         String?
  grantedAt       DateTime?
  revokedAt       DateTime?
  recordedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subjectType, subjectId])
  @@index([consentType, status])
}

model JaraMeetingIntegration {
  id              String   @id @default(cuid())
  platform        String   // zoom | google_meet | microsoft_teams | livekit | custom
  displayName     String
  enabled         Boolean  @default(false)
  config          String?  // JSON, secrets must be redacted/encrypted outside DB in production
  authStatus      String   @default("not_configured") // not_configured | configured | error
  lastCheckedAt   DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([platform, enabled])
}

model JaraKnowledgeSource {
  id              String   @id @default(cuid())
  title           String
  sourceType      String   @default("text") // text | url | file | faq | policy
  content         String?
  sourceUrl       String?
  language        String?  // bn | en | mixed
  tags            String?  // JSON array
  isApproved      Boolean  @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  status          String   @default("draft") // draft | approved | archived
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, isApproved])
}

model JaraAsset {
  id              String   @id @default(cuid())
  kind            String   @default("background") // background | clothing | avatar | branding | environment
  name            String
  description     String?
  fileUrl         String?
  storageKey      String?
  mimeType        String?
  fileSize        Int?
  width           Int?
  height          Int?
  sha256          String?
  isApproved      Boolean  @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  status          String   @default("pending_review") // pending_review | approved | rejected | archived
  source          String   @default("upload") // upload | generated | system
  ownerId         String?
  metadata        String?  // JSON
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kind, status])
  @@index([isApproved])
}

model JaraMeetingProfile {
  id              String   @id @default(cuid())
  title           String
  purpose         String?
  meetingType     String   @default("custom_video_call") // internal | business_presentation | student_consultation | interview | online_class | training | client_meeting | custom_video_call
  scheduledAt     DateTime?
  durationMinutes Int?
  platform        String   @default("internal") // internal | zoom | google_meet | microsoft_teams | custom
  participants    String?  // JSON array
  // Presentation
  appearanceProfileId String?
  clothing        String?  // JSON or preset id
  background      String?
  backgroundUrl   String?
  avatarStyle     String?
  presentationStyle String?
  voiceLanguage   String?  // bn | en | mixed
  voiceProfile    String?
  speakingStyle   String?
  // Content/instructions
  script          String?
  talkingPoints   String?  // JSON array or text
  instructions    String?
  // Media references (trusted local paths/asset IDs)
  referenceImageAssetId String?
  referenceVideoAssetId String?
  voiceSampleAssetId    String?
  referenceImageUrl     String?
  referenceVideoUrl     String?
  voiceSampleUrl        String?
  // Status/governance
  status          String   @default("draft") // draft | preview | approved | scheduled | active | completed | cancelled
  scope           String   @default("meeting_specific") // meeting_specific | temporary_next_call | persistent
  approvedBy      String?
  approvedAt      DateTime?
  cancelledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  configVersion   Int      @default(1)
  configSnapshot  String?  // JSON snapshot at approval/start
  rendererStatus  String   @default("unconfigured") // unconfigured | browser_fallback | gpu_worker | livekit_avatar
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([createdBy])
}

model JaraJob {
  id             String   @id @default(cuid())
  type           String
  status         String   @default("pending") // pending | running | completed | failed | cancelled
  payload        String?  // JSON
  result         String?  // JSON
  error          String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  idempotencyKey String?  @unique
  runAfter       DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, runAfter])
  @@index([type])
}
