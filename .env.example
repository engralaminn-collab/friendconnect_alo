# FriendConnect environment
# Copy to .env and fill in production values.
#   cp .env.example .env

NODE_ENV=development
LOG_LEVEL=info

# App
# Project root for relative paths (DATABASE_URL=file:./…, UPLOAD_DIR=./…). Auto-detected,
# including when running the Next.js standalone server (.next/standalone).
# APP_DIR=/var/www/friendconnect
# Session cookie Secure flag: auto (Secure when the request came over https). Force with true/false.
# COOKIE_SECURE=
PORT=3000
HOSTNAME=0.0.0.0
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Database
# Local / this repo: SQLite via Node (no Prisma engine download required)
DATABASE_URL="file:./db/custom.db"
# Production MySQL 8 (use with `npx prisma generate` + migrate deploy):
# DATABASE_URL="mysql://friendconnect:changeme@127.0.0.1:3306/friendconnect"

# Realtime
SOCKET_PORT=3003
SOCKET_INTERNAL_URL=http://127.0.0.1:3003
NEXT_PUBLIC_SOCKET_URL=

# Redis (optional — in-memory fallback if empty)
REDIS_URL=redis://127.0.0.1:6379

# Uploads
UPLOAD_DIR=./upload
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Email (optional — OTP printed in non-production if unset)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@friendconnect.app
SMTP_SECURE=false

# Local TLS (self-signed). Production: Caddy Let's Encrypt on APP_DOMAIN.
TLS_CERT=./certs/dev-cert.pem
TLS_KEY=./certs/dev-key.pem
HTTPS_PORT=3443

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@friendconnect.app

# WebRTC
# IMPORTANT: browsers only allow camera/microphone on https:// (or localhost).
# Opening the app via http://<server-ip> makes voice/video calls and voice notes impossible.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
# A loopback host here (127.0.0.1/localhost) is automatically replaced with the public
# host the browser used, so the bundled node-turn works out of the box. With Coturn or a
# separate TURN host, put its public address: turn:turn.example.com:3478
TURN_SERVERS=turn:127.0.0.1:3478
TURN_USERNAME=friendconnect
TURN_PASSWORD=fc-turn-dev-local
TURN_SECRET=
TURN_REALM=friendconnect
TURN_PORT=3478
# Public IP of this server — REQUIRED for the bundled node-turn relay (scripts/turn-server.js)
# to work across networks (mobile data <-> WiFi). Open UDP 3478 + TURN_MIN_PORT-TURN_MAX_PORT.
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Setup seed (demo accounts). Disabled in production unless ALLOW_SETUP=true
ALLOW_SETUP=false
SETUP_SECRET=

# === AI Gateway (set ONE provider — all free/open-source options available) ===
# 1. Ollama (self-hosted, 100% free, open-source) — RECOMMENDED
#    Install: curl -fsSL https://ollama.com/install.sh | sh
#    Pull model: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. Z.ai SDK (free tier, already installed)
# ZAI_API_KEY=

# 3. OpenRouter (free models)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 4. Hugging Face (free inference tier — 1000 req/day)
# HUGGINGFACE_API_KEY=
# HF_MODEL=mistralai/Mistral-7B-Instruct

# 5. OpenAI-compatible (any provider, paid)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
