# FriendConnect environment
# Copy to .env and fill in production values.
#   cp .env.example .env

NODE_ENV=development
LOG_LEVEL=info

# App
PORT=3000
HOSTNAME=0.0.0.0
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Database
# Local / this repo: SQLite via Node (no Prisma engine download required)
DATABASE_URL="file:./db/custom.db"
# Production MySQL 8 (use with `npx prisma generate` + migrate deploy):
# DATABASE_URL="mysql://friendconnect:changeme@127.0.0.1:3306/friendconnect"

# Realtime
SOCKET_PORT=3003
SOCKET_INTERNAL_URL=http://127.0.0.1:3003
NEXT_PUBLIC_SOCKET_URL=

# Redis (optional — in-memory fallback if empty)
REDIS_URL=redis://127.0.0.1:6379

# Uploads
UPLOAD_DIR=./upload
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Email (optional — OTP printed in non-production if unset)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@friendconnect.app
SMTP_SECURE=false

# Local TLS (self-signed). Production: Caddy Let's Encrypt on APP_DOMAIN.
TLS_CERT=./certs/dev-cert.pem
TLS_KEY=./certs/dev-key.pem
HTTPS_PORT=3443

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@friendconnect.app

# WebRTC
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_SERVERS=turn:127.0.0.1:3478
TURN_USERNAME=friendconnect
TURN_PASSWORD=fc-turn-dev-local
TURN_SECRET=
TURN_REALM=friendconnect
TURN_PORT=3478

# Setup seed (demo accounts). Disabled in production unless ALLOW_SETUP=true
ALLOW_SETUP=false
SETUP_SECRET=
