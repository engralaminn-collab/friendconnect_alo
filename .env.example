# FriendConnect environment
# Copy to .env and fill in production values.
#   cp .env.example .env

NODE_ENV=development
LOG_LEVEL=info

# App
# Project root for relative paths (DATABASE_URL=file:…, UPLOAD_DIR=./…). Auto-detected,
# including when running the Next.js standalone server (.next/standalone).
# APP_DIR=/var/www/friendconnect
# Session cookie Secure flag: auto (Secure when the request came over https). Force with true/false.
# COOKIE_SECURE=
PORT=3000
HOSTNAME=0.0.0.0
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# REQUIRED in production. Sessions and WebSocket tokens are signed with this.
# The app now refuses to serve auth routes in production if it is unset,
# instead of falling back to the dev secret that ships in this repository.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Bearer token for GET /api/metrics (Prometheus scrapers cannot hold a session).
# If unset, /api/metrics is admin-session-only.
METRICS_TOKEN=

# Database
# Local / this repo: SQLite via Node (no Prisma engine download required)
DATABASE_URL="file:./db/custom.db"
# Production MySQL 8 (use with `npx prisma generate` + migrate deploy):
DATABASE_URL="mysql://friendconnect:changeme@127.0.0.1:3306/friendconnect"

# Realtime
SOCKET_PORT=3003
# App -> realtime server (internal event fanout)
SOCKET_INTERNAL_URL=http://127.0.0.1:3003
# Realtime server -> app (Jara answers socket-sent messages through the app,
# because the AI gateway lives in the Next build). Defaults to 127.0.0.1:$PORT.
APP_INTERNAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SOCKET_URL=

# Redis (optional — in-memory fallback if empty)
REDIS_URL=redis://127.0.0.1:6379

# Uploads
UPLOAD_DIR=./upload
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Email (optional — OTP printed in non-production if unset)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@friendconnect.app
SMTP_SECURE=false

# Local TLS (self-signed). Production: Caddy Let's Encrypt on APP_DOMAIN.
TLS_CERT=./certs/dev-cert.pem
TLS_KEY=./certs/dev-key.pem
HTTPS_PORT=3443

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@friendconnect.app

# WebRTC
# IMPORTANT: browsers only allow camera/microphone on https:// (or localhost).
# Opening the app via http://<server-ip> makes voice/video calls and voice notes impossible.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
# A loopback host here (127.0.0.1/localhost) is automatically replaced with the public
# host the browser used, so the bundled node-turn works out of the box. With Coturn or a
# separate TURN host, put its public address: turn:turn.example.com:3478
TURN_SERVERS=turn:127.0.0.1:3478
TURN_USERNAME=friendconnect
TURN_PASSWORD=fc-turn-dev-local
TURN_SECRET=
TURN_REALM=friendconnect
TURN_PORT=3478
# Public IP of this server — REQUIRED for the bundled node-turn relay (scripts/turn-server.js)
# to work across networks (mobile data <-> WiFi). Open UDP 3478 + TURN_MIN_PORT-TURN_MAX_PORT.
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Setup seed (demo accounts). Disabled in production unless ALLOW_SETUP=true
ALLOW_SETUP=false
SETUP_SECRET=

# === AI Gateway (set ONE provider — all free/open-source options available) ===
# 1. Ollama (self-hosted, 100% free, open-source) — RECOMMENDED
#    Install: curl -fsSL https://ollama.com/install.sh | sh
#    Pull model: ollama pull llama3.2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. LiteLLM (BerriAI — self-hosted OpenAI-compatible AI gateway; cost tracking,
#    guardrails, load balancing; best paired with a local/self-hosted model)
# LITELLM_URL=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-4o-mini
# Jara input guardrails (block prompts containing obvious secrets/credentials
# before they reach any provider). Default: on. Set to 'off' to disable.
# JARA_AI_GUARDRAILS=on

# 3. Z.ai SDK (free tier, already installed)
# ZAI_API_KEY=

# 3. OpenRouter (free models)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 4. Hugging Face (free inference tier — 1000 req/day)
# HUGGINGFACE_API_KEY=
# HF_MODEL=mistralai/Mistral-7B-Instruct

# 5. OpenAI-compatible (any provider, paid)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# === Jara Voice Server ASR & TTS (optional — defaults to browser Web Speech fallback) ===
# Self-hosted OpenAI-compatible Faster-Whisper / Whisper.cpp ASR
JARA_ASR_URL=http://127.0.0.1:9000
JARA_ASR_MODEL=Systran/faster-whisper-small
# JARA_ASR_API_KEY=
# Self-hosted Piper / Orpheus / OpenAI-compatible TTS server
JARA_TTS_URL=http://127.0.0.1:5000
# PIPER_URL=http://127.0.0.1:5000
JARA_TTS_VOICE=bn_BD-openjtalk
# JARA_TTS_API_KEY=
# Or enable OpenAI Whisper + OpenAI TTS using OPENAI_API_KEY:
# JARA_VOICE_USE_OPENAI=false
# JARA_ASR_MODEL=whisper-1
# JARA_TTS_MODEL=gpt-4o-mini-tts

# === Jara Built-in Tools (optional — read-only tools for authenticated users) ===
# Web search tool: SearXNG instance (preferred, self-hosted) or Brave Search API.
# Without one of these, the web_search tool reports "unconfigured" (fail-closed).
# JARA_SEARCH_URL=http://localhost:8888
# JARA_BRAVE_API_KEY=
# Note: weather (Open-Meteo, no key) and calculator/time/knowledge tools need no keys.

# === Jara Multi-Provider SMS Gateway (optional — off by default) ===
# Configured via Jara Config Center (Super Admin) or env defaults:
# httpSMS (https://httpsms.com — self-hosted Android SIM gateway):
# HTTPSMS_API_KEY=
# HTTPSMS_FROM_NUMBER=+8801700000000
# HTTPSMS_WEBHOOK_SECRET=
# Telnyx Messaging v2:
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=+15551234567
# TELNYX_PUBLIC_KEY=
# Twilio Programmable SMS:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# Safety & webhook URL controls:
# JARA_SMS_PUBLIC_WEBHOOK_URL=https://your-domain.com/api/jara/sms/webhook

# === Jara GPU Avatar / Video Renderer (optional — defaults to browser fallback) ===
# Self-hosted InfiniteTalk / LivePortrait / MuseTalk HTTP worker.
# Reference open-source talking-avatar worker: MeiGen-AI/InfiniteTalk (Apache-2.0)
# or MeiGen-AI/MultiTalk (Apache-2.0) — deploy separately, then point Jara at it.
# JARA_GPU_WORKER_URL=http://127.0.0.1:8189
# JARA_GPU_WORKER_TOKEN=
# Local ComfyUI API server:
# COMFYUI_API_URL=http://127.0.0.1:8188
# Cloud RunningHub ComfyUI API:
# RUNNINGHUB_API_KEY=
# RUNNINGHUB_WORKFLOW_ID=
# RUNNINGHUB_API_URL=https://www.runninghub.cn
# LiveKit Avatar Agent Worker:
# JARA_LIVEKIT_AVATAR_URL=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# === Upload Malware Scanning (optional ClamAV clamd INSTREAM) ===
# JARA_MALWARE_SCAN=clamav
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_SOCKET=/var/run/clamav/clamd.ctl
# === Referenced-but-optional aliases & operational knobs (names only, no secrets) ===
# AI provider aliases
# AI_API_KEY=                      # alternative to OPENAI_API_KEY (openai-compatible)
# PRISMA_LOG=warn,error            # prisma log levels for the sqlite runtime
# Jara voice aliases (prefer JARA_ASR_URL / JARA_TTS_URL)
# WHISPER_URL=                     # alt ASR URL
# FASTER_WHISPER_URL=              # alt ASR URL
# PIPER_TTS_URL=                   # alt TTS URL
# ORPHEUS_URL=                     # alt TTS URL
# WebRTC / TURN / LiveKit
# TURN_SERVER=turn:turn.example.com:3478    # or STUN_SERVER=stun:stun.l.google.com:19302
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USER=
# NEXT_PUBLIC_TURN_PASSWORD=
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-host
# NEXT_PUBLIC_APP_URL=https://your-domain
# Realtime internals
# SOCKET_INTERNAL_SECRET=          # server-to-app shared secret (falls back to NEXTAUTH_SECRET)
# SOCKET_HOST=0.0.0.0              # bind address of socket-server.js
# CHAT_SERVICE_PORT=3003           # mini-services/chat-service port
# Database internals
# DB_ENGINE=                       # "prisma" forces Prisma Client even for file: URLs
# DB_POOL_SIZE=10                  # MariaDB connection limit
# DB_ALLOW_SQLITE_FALLBACK=true    # local dev only; IGNORED when NODE_ENV=production
# SMS provider knobs
# JARA_SMS_WEBHOOK_BASE_URL=       # alternative to JARA_SMS_PUBLIC_WEBHOOK_URL
# HTTPSMS_API_URL=                 # default https://api.httpsms.com
# HTTPSMS_WEBHOOK_SIGNING_KEY=     # alternative to JARA_SMS_WEBHOOK_SECRET
# Dev-only preview embedding
# ALLOW_FRAME_PREVIEW=true         # allows *.e2b.app iframe embedding outside production
