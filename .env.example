# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: TURN relays improve WebRTC call connectivity when direct peer-to-peer
# paths are blocked. VITE_ values ship to the browser; use temporary credentials only.
# Never place a long-lived TURN secret here or commit real credentials.
VITE_TURN_URLS="turn:your-turn-host:3478,turns:your-turn-host:5349"
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Optional first-party migration client. Keep disabled until a staging API,
# HTTPS origin, and end-to-end client flow have been verified.
VITE_SELF_HOSTED_API_ENABLED="false"
