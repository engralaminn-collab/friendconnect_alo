# FriendConnect — Production Caddyfile
# Deploy to: /etc/caddy/Caddyfile (with domain substitution)
# Caddy auto-provisions HTTPS via Let's Encrypt.
#
# Replace YOUR_DOMAIN with your actual domain (e.g. friendconnect.example.com)
# If no domain, use :80 with self-signed (not recommended for production).

YOUR_DOMAIN {
	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		# CSP — adjust as needed for your setup
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' wss: https:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
		# Remove Caddy version header
		-Server
	}

	# Compression
	encode gzip zstd

	# Upload size limit (50MB max file upload)
	request_body {
		max_size 50MB
	}

	# Timeouts
	timeouts {
		read 60s
		write 60s
		header 10s
	}

	# WebSocket support for realtime service
	# Socket.io connections use /?XTransformPort=3003
	@realtime query XTransformPort=3003
	handle @realtime {
		reverse_proxy localhost:3003 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Main app (Next.js on :3000)
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Health check endpoint (no auth required)
	@api_health path /api/health /api/metrics
	handle @api_health {
		reverse_proxy localhost:3000
	}
}
