# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# FriendConnect runtime artifacts.
#
# `upload/` is the default UPLOAD_DIR (src/lib/paths.ts) and holds user files
# keyed by random id. Only the directory itself is tracked, via .gitkeep: the
# previous ignore rule listed `public/uploads/`, a path the code never writes to,
# so real uploads were one `git add` away from being committed.
/upload/*
!/upload/.gitkeep

# Runtime database files. `db/` is where DATABASE_URL=file:./db/… resolves; a
# committed database would leak messages and, on `git checkout`, silently revert
# a production database to an old copy.
/db/
*.db
*.db-journal
*.db-wal
*.db-shm

# SQLite backups taken by scripts/deploy.sh before a migration.
/backups/

# Local upload overrides and per-service environment files.
/public/uploads/
/mini-services/chat-service/.env

# Runtime PID and log files.
/.zscripts/dev.pid
.zscripts/*.log
/tmp/

# NOTE: `.env.example` is intentionally NOT ignored — it documents every required
# variable. The previous `/skills/!.env.example` line was a malformed rule that
# did nothing (the `!` cannot un-ignore inside a pattern).

# Playwright output (traces, screenshots, video)
playwright-report/
test-results/
playwright/.cache/
e2e-run.log
# Captured integration-test output, parsed into annotations by CI
integration-run.log
