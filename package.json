{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:all": "node scripts/dev-all.cjs",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "env:check": "node scripts/check-env.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:security && npm run build && npm run test:integration && npm run test:e2e",
    "test:unit": "tsx --test tests/ai/*.test.ts tests/jara/*.test.ts",
    "test:ai:evaluation-schema": "tsx --test tests/ai/evaluation-scenarios.test.ts",
    "ai:evaluate": "tsx scripts/ai-evaluate.ts",
    "test:integration": "tsx --test tests/integration/*.test.cjs tests/integration/*.test.ts",
    "schema:variants": "node scripts/generate-schema-variants.mjs",
    "schema:metadata": "node scripts/generate-schema-metadata.mjs",
    "schema:ddl": "node scripts/generate-sqlite-ddl.mjs",
    "schema:generate": "npm run schema:variants && npm run schema:metadata && npm run schema:ddl && npm run schema:migration",
    "schema:check": "node scripts/generate-schema-variants.mjs --check && node scripts/generate-schema-metadata.mjs --check && node scripts/generate-sqlite-ddl.mjs --check && node scripts/generate-mysql-migration.mjs --check && node scripts/check-schema-drift.mjs && npm run schema:parity",
    "test:e2e": "playwright test",
    "test:security": "tsx --test tests/security/*.test.ts tests/security/*.test.cjs",
    "schema:migration": "node scripts/generate-mysql-migration.mjs",
    "backfill:file-access": "node scripts/backfill-file-access.cjs",
    "schema:parity": "node scripts/generate-parity-repair-migration.mjs --check && node scripts/check-provider-parity.mjs"
  },
