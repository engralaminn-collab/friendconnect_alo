{
  "name": "FriendConnect — Personal messaging",
  "short_name": "FriendConnect",
  "description": "Private personal communication app with chat, voice & video calls.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#10b981",
  "categories": ["social", "communication"],
  "icons": [
    {
      "src": "/friendconnect-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/friendconnect-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/friendconnect-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Chats",
      "url": "/?view=chats",
      "description": "Open your conversations"
    },
    {
      "name": "New chat",
      "url": "/?action=new-chat",
      "description": "Start a new conversation"
    }
  ],
  "screenshots": [],
  "prefer_related_applications": false
}
