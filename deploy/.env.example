# FriendConnect — environment configuration
# Copy to .env and edit before running `docker compose up -d`

# === Auth ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_32_BYTE_SECRET
NEXTAUTH_URL=http://localhost:3000

# === Database ===
POSTGRES_USER=fc
POSTGRES_PASSWORD=change_me_in_production

# === Object storage (MinIO) ===
MINIO_ROOT_USER=fc_admin
MINIO_ROOT_PASSWORD=change_me_in_production
S3_BUCKET=friendconnect-attachments

# === SMTP (Mailpit for dev; swap for real provider in prod) ===
# For Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
# For SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587
# For Amazon SES: SMTP_HOST=email-smtp.us-east-1.amazonaws.com SMTP_PORT=587
SMTP_FROM=no-reply@friendconnect.local

# === TURN (for WebRTC, future voice/video) ===
TURN_REALM=friendconnect.local
TURN_EXTERNAL_IP=127.0.0.1
TURN_USER=fc
TURN_PASSWORD=change_me

# === Push notifications (generate with: npx web-push generate-vapid-keys) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@friendconnect.local
