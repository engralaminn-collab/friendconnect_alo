# FriendConnect on learn.aloeducation.com — copy to /home/aloedu/friendconnect/.env
#   cp deploy/learn.aloeducation.com/env.production.example .env && nano .env
# Replace every CHANGE_ME. Generate secrets with:  openssl rand -base64 32
NODE_ENV=production
LOG_LEVEL=info
APP_DIR=/home/aloedu/friendconnect
PM2_NAME=friendconnect

# Public address (must be https:// — browsers block camera/mic on plain http)
APP_DOMAIN=learn.aloeducation.com
APP_ORIGIN=https://learn.aloeducation.com
NEXTAUTH_URL=https://learn.aloeducation.com

# Ports (only reachable through Caddy; nothing listens publicly except TURN)
PORT=3017
HOSTNAME=127.0.0.1
SOCKET_PORT=3018
SOCKET_HOST=127.0.0.1
SOCKET_INTERNAL_URL=http://127.0.0.1:3018
NEXT_PUBLIC_SOCKET_URL=

# MySQL 8 — URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A)
DATABASE_URL="mysql://user_learn:CHANGE_ME@127.0.0.1:3306/db_learn"
DB_POOL_SIZE=10

# Redis (note: 6379, not 637.9)
REDIS_URL=redis://127.0.0.1:6379

# Uploads (own sub-folder so files don't mix with other apps)
STORAGE_PROVIDER=local
UPLOAD_DIR=/home/aloedu/storage/uploads/friendconnect

# Email via Resend SMTP (password = your Resend API key; the from-domain must be verified in Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME_re_xxxxxxxx
SMTP_FROM="FriendConnect <noreply@aloeducation.com>"

# Web Push (optional) — generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aloeducation.com

# WebRTC calls
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
TURN_ENABLED=true
TURN_SERVERS=turn:learn.aloeducation.com:3478
TURN_USERNAME=friendconnect
TURN_PASSWORD=CHANGE_ME_long_random
TURN_SECRET=
TURN_REALM=aloeducation.com
TURN_PORT=3478
TURN_EXTERNAL_IP=103.231.239.79
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Demo-account seeding stays off in production
ALLOW_SETUP=false
SETUP_SECRET=
