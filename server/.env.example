# Copy to server/.env for local development only. Never commit server/.env.
NODE_ENV=development
PORT=3210
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
SESSION_COOKIE_NAME=friendconnect_session
SESSION_TTL_DAYS=30
SESSION_CSRF_SECRET=development-only-replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=friendconnect
DB_USER=friendconnect_dev
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

MEDIA_ROOT=./var/media
MEDIA_MAX_UPLOAD_BYTES=26214400
USER_STORAGE_QUOTA_BYTES=1073741824
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Mail is required to register and to deliver verification/reset messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Temporary credentials are issued server-side; never put TURN_SHARED_SECRET in a client bundle.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600

# Generate with the web-push tooling; public key may be delivered to authenticated browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
LOG_LEVEL=info
