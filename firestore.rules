rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().exists && currentUser().data.isActive == true
        && (currentUser().data.approved == null || currentUser().data.approved == true);
    }

    function admin() {
      return activeUser() && currentUser().data.role == 'admin';
    }

    function isParticipant(data) {
      return activeUser() && request.auth.uid in data.participants;
    }

    function areBlocked(firstUserId, secondUserId) {
      return exists(/databases/$(database)/documents/blocks/$(firstUserId + '_' + secondUserId))
        || exists(/databases/$(database)/documents/blocks/$(secondUserId + '_' + firstUserId));
    }

    function acceptedRequestExists(firstUserId, secondUserId) {
      // getAfter supports the accept-request + create-friendships batch used by the client.
      return (exists(/databases/$(database)/documents/friendRequests/$(firstUserId + '_' + secondUserId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(firstUserId + '_' + secondUserId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/friendRequests/$(secondUserId + '_' + firstUserId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(secondUserId + '_' + firstUserId)).data.status == 'accepted');
    }

    match /users/{userId} {
      // Profiles are needed to display chat and friend identities. Sensitive fields must never be stored here.
      allow read: if activeUser() || admin();
      // Accounts are provisioned by a trusted administrator or Admin SDK, never by a public client.
      allow create: if admin();
      allow update: if admin() || (activeUser() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'username', 'photoUrl', 'bio', 'profileVisibility', 'onlineStatus', 'lastSeen']));
      allow delete: if admin();
    }

    match /friendRequests/{requestId} {
      allow read: if activeUser()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && !areBlocked(request.auth.uid, request.resource.data.receiverId);
      // Only the recipient can accept/reject; request parties cannot rewrite its identities.
      allow update: if activeUser()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if activeUser()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /friends/{friendId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid || resource.data.friendId == request.auth.uid);
      // A friendship can only be created from an accepted request and by one of its parties.
      allow create: if activeUser()
        && (request.resource.data.userId == request.auth.uid || request.resource.data.friendId == request.auth.uid)
        && request.resource.data.userId != request.resource.data.friendId
        && acceptedRequestExists(request.resource.data.userId, request.resource.data.friendId);
      allow delete: if activeUser()
        && (resource.data.userId == request.auth.uid || resource.data.friendId == request.auth.uid);
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data);
      allow create: if activeUser()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && !areBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);
      // Participants cannot be added or removed after a chat is created.
      allow update: if isParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId
          && request.resource.data.type in ['text', 'image', 'video', 'file', 'voice'];
        // A sender may edit/delete only their own content and cannot change ownership or timestamps.
        allow update: if activeUser() && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.chatId == resource.data.chatId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'isEdited', 'reactions', 'status', 'readAt']);
        allow delete: if activeUser() && resource.data.senderId == request.auth.uid;
      }
    }

    match /calls/{callId} {
      allow read: if activeUser()
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && !areBlocked(request.auth.uid, request.resource.data.receiverId);
      allow update: if activeUser()
        && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.receiverId == resource.data.receiverId;
      allow delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if activeUser()
        && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid;
      allow delete: if activeUser() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if admin();
    }
  }
}
